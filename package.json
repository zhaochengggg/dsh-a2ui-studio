{
  "name": "dsh-control-studio",
  "version": "0.3.1",
  "description": "DSH Control Studio: agent-authored monitoring and control panels for machines and apps",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./remote": "./lib/remote.js",
    "./typert": "./lib/remote.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "lib",
    "machines/index.mjs",
    "machines/store.mjs",
    "machines/probe.mjs",
    "machines/remote.mjs",
    "machines/observations.mjs",
    "machines/lib",
    "apps/lib",
    "apps/skills",
    "apps/examples/extensions/range",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "docs",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs machines/test.mjs machines/controller.test.mjs machines/probe.test.mjs",
    "test:apps": "vitest run --config vitest.config.mjs",
    "prepack": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dependencies": {
    "esbuild": "0.28.1",
    "zod": "4.1.12",
    "yaml": "2.8.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-alpha.1",
    "@deepseek-ai/schemastery": "~3.18.2",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-util-values": "0.2.1-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-loader": "1.0.6-alpha.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.10-alpha.1",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-skill": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-user-questions": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-subprocess-local": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-alpha.1",
    "fast-xml-parser": "5.2.5",
    "@a2ui/web_core": "0.10.7",
    "jsonata": "2.1.0",
    "zod-to-json-schema": "3.25.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@testing-library/react": "16.3.0",
    "vitest": "3.2.4",
    "jsdom": "26.1.0"
  },
  "license": "MIT"
}
